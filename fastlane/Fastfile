default_platform(:ios)

platform :ios do

  APP_BUNDLE_ID = "com.keisukearai.MyHandMemo"

  def api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
    )
  end

  def current_version
    get_version_number(xcodeproj: "MyHandMemo.xcodeproj", target: "MyHandMemo")
  end

  # メタデータ（テキスト）のみアップロード。バイナリ・スクリーンショットは触らない。
  # バイナリは Xcode の Organizer から、スクリーンショットは App Store Connect の画面から手動で上げる。
  lane :upload_metadata do
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_BUNDLE_ID,
      app_version: current_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
      copyright: "#{Time.now.year} Keisuke Arai",
      # 年齢制限の質問票。中身は fastlane/metadata/app_store_rating_config.json
      app_rating_config_path: "fastlane/metadata/app_store_rating_config.json",
      app_review_information: {
        first_name: "Keisuke",
        last_name: "Arai",
        phone_number: ENV["REVIEW_PHONE"],
        email_address: ENV["REVIEW_EMAIL"],
        demo_user: "",
        demo_password: "",
        notes: "No sign-in or network connection is required. All features are available immediately after launch. Notes are drawn with a finger on the canvas and are stored only on the device; nothing is sent anywhere. The display language can be switched in Settings (Match Device / Japanese / English).",
      },
    )
  end

  # スクリーンショットのみアップロード。撮影は fastlane/capture_screenshots.sh。
  lane :upload_screenshots do
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_BUNDLE_ID,
      app_version: current_version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
    )
  end

end
